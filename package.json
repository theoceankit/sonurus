{
  "name": "sonorus",
  "version": "0.1.0",
  "description": "Sonorus - local AI transcription with speaker identification",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "bundle-backend": "node scripts/bundle-backend.js",
    "build:mac": "node scripts/bundle-backend.js && electron-builder --mac",
    "build:win": "node scripts/bundle-backend.js && electron-builder --win",
    "build:linux": "node scripts/bundle-backend.js && electron-builder --linux",
    "build:all": "node scripts/bundle-backend.js && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.sonorus.app",
    "productName": "Sonorus",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        { "target": "dmg" }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "background": null,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sonorus"
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "ffmpeg-static": "^5.3.0",
    "png2icons": "^2.0.1",
    "tar": "^7.5.16"
  },
  "dependencies": {
    "playwright": "^1.60.0",
    "playwright-core": "^1.60.0"
  }
}
